{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "description": "Block destructive gws calls and direct Gmail sends outside @upstart.com",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/block-destructive.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "description": "Block gws commands targeting non-upstart.com email addresses or user identifiers",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/check-domain.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "description": "Redirect to /google-workspace:setup if the gws plugin is not yet configured",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/check-setup.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
